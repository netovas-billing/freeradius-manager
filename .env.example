# Dev stack freeradius-manager (docker-compose.dev.yml).
# Salin jadi `.env` lalu sesuaikan — berkas .env TIDAK ikut ter-commit.

# IP yang ditulis ke radius_servers.url saat RM-API membuat instance baru.
# Kosongkan (atau biarkan baris ini) kalau backend + RM-API sama-sama jalan di
# host yang sama. Isi dengan IP LAN laptop Anda kalau backend jalan di dalam
# Docker atau NAS MikroTik dari LAN ikut menembak RADIUS dev ini.
#RM_DEV_PUBLISH_IP=192.168.200.189

# Alamat bind port dev. Default 0.0.0.0 (bisa diakses dari LAN) supaya alur
# end-to-end bisa diuji. Persempit ke 127.0.0.1 saat berada di jaringan publik.
#RM_DEV_BIND=127.0.0.1
