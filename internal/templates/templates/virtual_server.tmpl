{{- if .DynamicClientNet }}
# ============================================================================
# DAFTAR CLIENT PER-SOCKET untuk instance ini.
#
# Kenapa ada blok `clients` tersendiri dan bukan `client { }` di dalam
# `listen { }`: bentuk `clients = <nama>` pada listener adalah bentuk yang
# DIDOKUMENTASIKAN FreeRADIUS (clients.conf: "edit a 'listen' section to add:
# clients = per_socket_clients"), sedangkan `client { }` yang disarangkan
# langsung di dalam `listen { }` tidak ada dasarnya.
#
# Dua akibat yang dua-duanya kita butuhkan:
#
#   1. `ipaddr` boleh 0.0.0.0/0 tanpa bertabrakan antar instance. Satu mesin
#      melayani BANYAK instance dalam SATU daemon; kalau blok client se-luas
#      itu diletakkan global, instance kedua mendefinisikan ulang jaringan
#      yang sama dan yang menang adalah yang kebetulan dimuat lebih dulu.
#      Di dalam `clients <nama>` miliknya sendiri, tiap instance aman.
#
#   2. Client dari SQL ikut pindah ke daftar ini. Dokumentasi FreeRADIUS:
#      "If there is a listener, and the first one does have a 'clients=...'
#      configuration item, SQL clients are added to that list." Tanpa
#      `clients =`, client SQL SEMUA instance menumpuk di satu daftar GLOBAL —
#      dan karena concentrator adalah sumber daya bersama, dua mitra bisa
#      punya nasname IDENTIK. Di daftar global itu hanya satu secret yang
#      bertahan, jadi NAS mitra yang kalah berhenti bekerja tanpa pesan apa
#      pun. Blok ini mencegahnya.
#
# `lifetime` disengaja TIDAK 0. Client dinamis yang kedaluwarsa dicari ulang
# ke tabel `nas`, sehingga GANTI SECRET dan HAPUS NAS ikut berlaku sendiri
# dalam ≤10 menit. Dengan lifetime = 0 keduanya butuh restart FreeRADIUS.
# ============================================================================
clients dynclist_{{ .InstanceName }} {
    client dyn_{{ .InstanceName }} {
        ipaddr          = {{ .DynamicClientNet }}
        dynamic_clients = dynclients_{{ .InstanceName }}
        lifetime        = 600
    }
}

{{ end }}
server {{ .InstanceName }} {

    # ============================================
    # NAS dibaca dari tabel nas di database
    # Tambahkan manual:
    #
    # USE {{ .InstanceName }};
    # INSERT INTO nas (nasname, shortname, type, secret, server)
    # VALUES ('IP_MIKROTIK', 'nama', 'other', 'secret', '{{ .InstanceName }}');
    # ============================================

    listen {
        type   = auth
        ipaddr = *
        port   = {{ .AuthPort }}
        limit {
            max_connections = 16
            lifetime        = 0
            idle_timeout    = 30
        }

{{- if .DynamicClientNet }}
        # Daftar client KHUSUS socket ini — lihat `clients dynclist_...` di
        # kepala berkas. Dipakai ketiga listener supaya SQL client dan client
        # dinamis mendarat di daftar yang SAMA.
        clients = dynclist_{{ .InstanceName }}
{{- end }}
    }

    listen {
        type   = acct
        ipaddr = *
        port   = {{ .AcctPort }}
        limit {
            max_connections = 16
            lifetime        = 0
            idle_timeout    = 30
        }

{{- if .DynamicClientNet }}
        # Daftar client KHUSUS socket ini — lihat `clients dynclist_...` di
        # kepala berkas. Dipakai ketiga listener supaya SQL client dan client
        # dinamis mendarat di daftar yang SAMA.
        clients = dynclist_{{ .InstanceName }}
{{- end }}
    }

    listen {
        type   = coa
        ipaddr = *
        port   = {{ .CoAPort }}
        limit {
            max_connections = 16
            lifetime        = 0
            idle_timeout    = 30
        }
{{- if .DynamicClientNet }}
        clients = dynclist_{{ .InstanceName }}
{{- end }}
    }

    authorize {
        filter_username
        preprocess
        chap
        mschap
        digest
        eap_{{ .InstanceName }} {
            ok = return
        }
        files
        sql_{{ .InstanceName }}
        expiration
        logintime
        pap
        Autz-Type New-TLS-Connection {
            ok
        }
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        mschap
        digest
        eap_{{ .InstanceName }}
    }

    preacct {
        preprocess
        acct_unique
        files
    }

    accounting {
        detail
        sql_{{ .InstanceName }}
        exec
        attr_filter.accounting_response
    }

    session {
        sql_{{ .InstanceName }}
    }

    post-auth {
        if (session-state:User-Name && reply:User-Name && request:User-Name && (reply:User-Name == request:User-Name)) {
            update reply {
                &User-Name !* ANY
            }
        }
        update {
            &reply: += &session-state:
        }
        sql_{{ .InstanceName }}
        exec
        remove_reply_message_if_eap
        Post-Auth-Type REJECT {
            sql_{{ .InstanceName }}
            attr_filter.access_reject
            eap_{{ .InstanceName }}
            remove_reply_message_if_eap
        }
        Post-Auth-Type Challenge {
        }
    }

    recv-coa {
        ok
    }

    send-coa {
        ok
    }
}

{{- if .DynamicClientNet }}

# ============================================================================
# Virtual server pencari NAS dinamis untuk instance ini.
#
# Dipicu FreeRADIUS saat paket tiba dari IP di dalam {{ .DynamicClientNet }}
# yang BELUM ada di daftar client. Ia mencari barisnya di tabel `nas`; kalau
# ketemu, NAS itu di-cache beserta secret-nya dan permintaannya diproses
# normal. Kalau tidak ketemu, permintaannya ditolak.
#
# Akibatnya NAS yang baru ditambahkan lewat API langsung terpakai TANPA restart
# FreeRADIUS. Sebelum ini, `read_clients = yes` hanya memuat daftar NAS saat
# start, jadi NAS baru adalah client tak dikenal dan paketnya DIBUANG tanpa
# balasan dan tanpa log — gejalanya "radius timeout" di router, yang juga
# gejala belasan hal lain. Tak ada jalur kode mana pun yang me-restart
# FreeRADIUS saat NAS ditambah, jadi itu langkah manual yang harus diingat.
#
# DUA HAL YANG TIDAK BOLEH DISALIN MENTAH dari contoh FreeRADIUS mana pun:
#
#   1. Modulnya HARUS sql_{{ .InstanceName }}, bukan `sql`. Tiap instance di
#      mesin ini punya modul SQL sendiri yang menunjuk DATABASE-nya sendiri;
#      memakai `sql` berarti mencari NAS di database instance yang salah.
#   2. FreeRADIUS-Client-Virtual-Server HARUS {{ .InstanceName }}, bukan
#      "default". Kalau salah, permintaannya diproses virtual server lain —
#      pelanggan milik mitra A diautentikasi terhadap data mitra B.
#
# Rate limit DoS: FreeRADIUS membatasi 1 client baru per detik. Hard-coded,
# tidak bisa diubah.
# ============================================================================
server dynclients_{{ .InstanceName }} {
    authorize {
        if ("%{sql_{{ .InstanceName }}: SELECT nasname FROM nas WHERE nasname = '%{Packet-Src-IP-Address}'}") {
            update control {
                &FreeRADIUS-Client-IP-Address     = "%{Packet-Src-IP-Address}"
                &FreeRADIUS-Client-Shortname      = "%{sql_{{ .InstanceName }}: SELECT COALESCE(shortname, nasname) FROM nas WHERE nasname = '%{Packet-Src-IP-Address}'}"
                &FreeRADIUS-Client-Secret         = "%{sql_{{ .InstanceName }}: SELECT secret FROM nas WHERE nasname = '%{Packet-Src-IP-Address}'}"
                &FreeRADIUS-Client-NAS-Type       = "%{sql_{{ .InstanceName }}: SELECT COALESCE(type, 'other') FROM nas WHERE nasname = '%{Packet-Src-IP-Address}'}"
                &FreeRADIUS-Client-Virtual-Server = "{{ .InstanceName }}"
            }
            ok
        }
        else {
            reject
        }
    }
}
{{- end }}
